*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
data/*.sqlite3
data/*.sqlite3-wal
data/*.sqlite3-shm
data/backups/
data/startup.log
data/mail-out/

# Node.js
node_modules/

# 秘密情報
.env
.env.*
!.env.example

# Python 仮想環境
.venv/
venv/

# ビルド・キャッシュ
dist/
build/
.next/
.cache/

# ログ
*.log

# 業務データ画像
data/images/placement/
data/images/names/

# ネーム catalog 取込（顧客データ）
data/name-import/

